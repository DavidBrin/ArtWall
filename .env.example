# Postgres connection for strokes and wall text.
# Required in production. Locally, drawing still works until you refresh
# if this is unset — saves will fail until the database is configured.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/artwall?sslmode=require

# Legacy Supabase keys (no longer used; the original project was deleted).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional app URL for future absolute links and install messaging.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

